# ============================================================================
# VisionFold Creative — environment variables
# Copy to .env.local for dev; set these (without quotes needed) in Vercel for prod.
# ============================================================================

# REQUIRED: Signs all session cookies. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# REQUIRED in production: Postgres connection string used by the app (drizzle).
# Supabase: Project Settings -> Database -> "Transaction pooler" (port 6543).
# Without DATABASE_URL the app falls back to in-memory storage — data is lost
# on every restart/redeploy.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Bootstrap admin (created by the database seed on first run).
# STRONGLY recommended in production; the fallback password is well-known.
ADMIN_EMAIL="visionfoldcreative@gmail.com"
ADMIN_PASSWORD="aliasgar134"

# Protects the Vercel Cron endpoint /api/cron/run-scheduled.
# Vercel automatically sends this as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# Canonical public URL of this deployment (used in metadata/emails).
APP_URL="https://visionfoldcreative.vercel.app"

# --- AI (optional) ------------------------------------------------------------
# EASIEST: no env needed — paste keys in Admin -> Automations & AI ("AI
# providers" card) or Studio copilot. Runtime keys go live without a redeploy.
#
# Provider chain (preferred first, default Gemini):
#   Gemini → xAI Grok → Groq → NVIDIA NIM → OpenAI → Pollinations → rules
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.1-8b-instruct"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
XAI_API_KEY=""
GROK_MODEL="grok-4.5"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# Hard daily cap on AI tokens (counted in the ai_usage table).
AI_DAILY_TOKEN_BUDGET="250000"

# Studio working FX used when a client quotes in USD (INR is always stored).
FX_USD_INR="83.5"

# --- Email / storage ----------------------------------------------------------
# The current build has no runtime dependency on Supabase Storage or Resend;
# they're documented here in case you add upload/email integrations later.
# (The media library stores external URLs; DATABASE_URL backs everything else.)

# ============================================================================


# --- Client portal payments (optional) ---------------------------------------
# Hosted checkout base URL. The app never marks invoices paid from the browser;
# confirm payment through your provider's webhook or admin UI.
# Client-facing invoice links (/pay/<id>) hand off to this URL.
PAYMENT_CHECKOUT_URL=""

# Payment completion webhook secret. Point your provider at:
#   POST <APP_URL>/api/webhooks/payment
#   X-VF-Pay-Signature: sha256=<hex hmac-sha256(secret, rawBody)>
#   {"invoiceNumber":"INV-1042","status":"paid","providerRef":"..."}
# This is the only automatic path that marks invoices paid.
# Falls back to JWT_SECRET when empty (fine for testing; rotate in prod).
PAYMENT_WEBHOOK_SECRET=""

# --- Transactional email (optional) ------------------------------------------
# Enables studio lead alerts + automation emails (acks, reminders, review
# requests). Without a key everything still works — email is just skipped.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""   # e.g. "VisionFold <studio@yourdomain.com>"
NOTIFICATION_EMAIL=""  # where "new lead" alerts go

# --- Demo data ---------------------------------------------------------------
# The seed only creates demo people (clients, leads, messages, reviews, activity)
# when SEED_DEMO="true" — production stays clean of placeholder names.
# Set it only if you want to preview the app with a full sample dataset.
SEED_DEMO=""
# Password assigned to seeded demo clients (local/demo only).
CLIENT_DEMO_PASSWORD="demo1234"

# --- Business prospecting (Google Maps) --------------------------------------
# Enables /admin/prospects — search businesses to pitch. Enable the
# "Places API (New)" in Google Cloud Console, restrict the key to that API.
GOOGLE_PLACES_API_KEY=""

# --- WhatsApp Cloud API automation -------------------------------------------
# Meta WhatsApp Business Cloud API. Enable these to send messages, receive a
# webhook inbox, and run the AI auto-reply bot.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_NUMBER=""   # your business number in E.164, e.g. +917725004639
WHATSAPP_VERIFY_TOKEN=""      # any secret you choose; used for webhook verification
WHATSAPP_AUTO_REPLY="false"   # "true" to let the AI answer inbound messages
# Point Meta's webhook at: https://<your-domain>/api/whatsapp/webhook

# ============================================================================
# --- Social publishing: YouTube + LinkedIn (optional) ------------------------
# ============================================================================
# /admin/social works fully OFFLINE without any of these: accounts run in
# "demo" mode and publishing/analytics are simulated so you can test the
# entire flow (compose -> AI SEO -> schedule -> publish -> day-3/day-7
# reviews). Add real credentials below to go live.

# YouTube (Google Cloud Console -> create OAuth client, type "Web application";
# enable "YouTube Data API v3"). Authorized redirect URI must be:
#   <APP_URL>/api/social/callback/youtube
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI=""
# Optional: API key for read-only public video stats (no OAuth needed).
YOUTUBE_API_KEY=""

# LinkedIn (developer.linkedin.com -> create app; request "Share on LinkedIn"
# and "Sign In with LinkedIn using OpenID Connect" products).
# Redirect URL: <APP_URL>/api/social/callback/linkedin
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI=""
# Optional: post as a company page instead of the member profile,
# e.g. urn:li:organization:1234567890 (requires r_organization_social).
LINKEDIN_ORGANIZATION_URN=""

# Instagram Reels publishing (Meta app -> Instagram Business account linked
# to a Facebook Page; scopes instagram_content_publish + instagram_basic +
# pages_show_list). Redirect URI: <APP_URL>/api/social/callback/instagram
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI=""

# TikTok direct-post (developer.tiktok.com app with video.publish scope).
# Redirect URL: <APP_URL>/api/social/callback/tiktok
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI=""
