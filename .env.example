# OPENROUTER_API_KEY: Required for AI generation via OpenRouter.
# Get one at https://openrouter.ai/keys
# Set this in Vercel: Project -> Settings -> Environment Variables (then redeploy).
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: Optional. Any model slug from https://openrouter.ai/models.
# Defaults to openai/gpt-4o-mini if not set.
OPENROUTER_MODEL="openai/gpt-4o-mini"

# JWT_SECRET: Required in production. Used to sign admin/client login sessions.
# Generate a strong random value, e.g.: openssl rand -base64 48
# Set this in Vercel under Project Settings > Environment Variables.
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# ADMIN_INITIAL_PASSWORD: Sets the admin account's password the FIRST time
# the database is created (fresh deploy / cold start with no existing data).
# If unset, an insecure default password is used and a warning is logged.
ADMIN_INITIAL_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"

# APP_URL: The URL where this app is hosted (used for OpenRouter's analytics headers).
APP_URL="https://vision-fold-creative.vercel.app"

# NODE_ENV: set to "production" in production deployments. Vercel sets this
# automatically; only needed manually for Cloud Run / other Node hosts.
NODE_ENV="production"

# =============================================================================
# SUPABASE (Optional - for persistent database storage)
# =============================================================================
# Create a project at https://supabase.com and get these from Project Settings
# If not set, the app falls back to JSON file storage (not persistent on Vercel)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional: For client-side storage access (not used in this project since all
# data access goes through the server API)
# SUPABASE_ANON_KEY="your-anon-key"

# Optional: Supabase Storage bucket for file uploads
# Create a bucket named "visionfold-uploads" in Supabase Storage
SUPABASE_STORAGE_BUCKET="visionfold-uploads"
