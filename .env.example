# ---------------------------------------------------------------------------
# VisionFold Creative — environment
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------------------

# Database (Postgres). Without it the app falls back to an in-memory database.
DATABASE_URL=

# Session signing. Set a long random string in production.
JWT_SECRET=

# First admin account, created on seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Transactional email (Resend) ------------------------------------------
# Without RESEND_API_KEY the app runs normally and simply sends nothing.
RESEND_API_KEY=
# Must be a verified domain in Resend, or use onboarding@resend.dev while testing.
EMAIL_FROM="VisionFold Creative <hello@yourdomain.com>"
# Where new-brief notifications and the daily digest land. Defaults to ADMIN_EMAIL.
STUDIO_EMAIL=

# --- Scheduled jobs ---------------------------------------------------------
# Set this and Vercel Cron will authenticate automatically.
CRON_SECRET=

# --- Public --------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://visionfoldcreative.vercel.app
# Optional: host the site-guide video off-repo.
NEXT_PUBLIC_SITE_GUIDE_SRC=

# --- Optional integrations --------------------------------------------------
# AI copilot (either provider, or neither — rules-based fallbacks are built in).
GEMINI_API_KEY=
NVIDIA_API_KEY=
# WhatsApp Cloud API.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Social publishing — see docs/SOCIAL_PUBLISHING.md for the review requirements.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
