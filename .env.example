# JWT_SECRET: Required to sign auth tokens. Use a long random string in production.
JWT_SECRET="MY_JWT_SECRET"

# Admin bootstrap (optional overrides)
ADMIN_EMAIL="visionfoldcreative@gmail.com"
ADMIN_PASSWORD="change-me"

# APP_URL: Canonical public URL of this deployment
APP_URL="https://visionfoldcreative.vercel.app"

# Supabase (optional but recommended for production persistence + Storage)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Resend (optional inquiry emails)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
NOTIFICATION_EMAIL="visionfoldcreative@gmail.com"

# AI — NVIDIA NIM free tier (preferred)
# Get a key: https://build.nvidia.com / NVIDIA NGC API key
# Set this in Vercel only — never commit the real key
NVIDIA_API_KEY=""
# NVIDIA_MODEL="meta/llama-3.1-8b-instruct"
# AI_DAILY_TOKEN_BUDGET="250000"

# Optional Gemini fallback (only used if NVIDIA_API_KEY is unset)
# GEMINI_API_KEY=""

# Hosted payment page used by the client portal. The app never marks an invoice
# paid from the browser; confirm payment through your provider webhook/admin.
PAYMENT_CHECKOUT_URL=""
