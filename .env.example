# OPENROUTER_API_KEY: Required for AI generation via OpenRouter.
# Get one at https://openrouter.ai/keys
# Set this in Vercel: Project -> Settings -> Environment Variables (then redeploy).
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: Optional. Any model slug from https://openrouter.ai/models.
# Defaults to openai/gpt-4o-mini if not set.
OPENROUTER_MODEL="openai/gpt-4o-mini"

# JWT_SECRET: Used to sign auth tokens. Set a real random value in production —
# server.ts falls back to an insecure hardcoded default if this is unset.
JWT_SECRET="MY_JWT_SECRET"

# APP_URL: The URL where this app is hosted (used for OpenRouter's analytics headers).
APP_URL="https://vision-fold-creative.vercel.app"

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY enable Supabase-backed persistence.
# Create the tables from supabase/schema.sql first, then set these in Vercel / local env.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# RESEND_API_KEY: Optional, but enables real inquiry email delivery.
RESEND_API_KEY=""
NOTIFICATION_EMAIL="visionfoldcreative@gmail.com"
