# JWT_SECRET: Required to sign auth tokens. Use a long random string in production.
JWT_SECRET="MY_JWT_SECRET"

# Admin bootstrap (optional overrides)
ADMIN_EMAIL="visionfoldcreative@gmail.com"
ADMIN_PASSWORD="change-me"

# APP_URL: Canonical public URL of this deployment
APP_URL="https://visionfoldcreative.vercel.app"

# Supabase (optional but recommended for production persistence + Storage)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Resend (optional inquiry emails)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
NOTIFICATION_EMAIL="visionfoldcreative@gmail.com"

# Gemini (Phase D) — OpenRouter has been removed in Phase A
# GEMINI_API_KEY=""
