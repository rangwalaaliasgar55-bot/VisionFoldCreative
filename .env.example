# ============================================================================
# VisionFold Creative — environment variables
# Copy to .env.local for dev; set these (without quotes needed) in Vercel for prod.
# ============================================================================

# REQUIRED: Signs all session cookies. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# REQUIRED in production: Postgres connection string used by the app (drizzle).
# Supabase: Project Settings -> Database -> "Transaction pooler" (port 6543).
# Without DATABASE_URL the app falls back to in-memory storage — data is lost
# on every restart/redeploy.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Bootstrap admin (created by the database seed on first run).
# STRONGLY recommended in production; the fallback password is well-known.
ADMIN_EMAIL="visionfoldcreative@gmail.com"
ADMIN_PASSWORD="aliasgar134"

# Protects the Vercel Cron endpoint /api/cron/run-scheduled.
# Vercel automatically sends this as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# Canonical public URL of this deployment (used in metadata/emails).
APP_URL="https://visionfoldcreative.vercel.app"

# --- AI (optional) -----------------------------------------------------------
# Preferred provider: NVIDIA NIM free tier.
# Key: https://build.nvidia.com (NVIDIA NGC API key)
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.1-8b-instruct"
# Fallback provider (used when NVIDIA_API_KEY is unset or NIM errors):
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
# Hard daily cap on AI tokens (counted in the ai_usage table).
AI_DAILY_TOKEN_BUDGET="250000"

# --- Email / storage ----------------------------------------------------------
# The current build has no runtime dependency on Supabase Storage or Resend;
# they're documented here in case you add upload/email integrations later.
# (The media library stores external URLs; DATABASE_URL backs everything else.)

# ============================================================================


# --- Client portal payments (optional) ---------------------------------------
# Hosted checkout base URL. The app never marks invoices paid from the browser;
# confirm payment through your provider's webhook or admin UI.
PAYMENT_CHECKOUT_URL=""

# --- Demo data ---------------------------------------------------------------
# The seed only creates demo people (clients, leads, messages, reviews, activity)
# when SEED_DEMO="true" — production stays clean of placeholder names.
# Set it only if you want to preview the app with a full sample dataset.
SEED_DEMO=""
# Password assigned to seeded demo clients (local/demo only).
CLIENT_DEMO_PASSWORD="demo1234"

# --- Business prospecting (Google Maps) --------------------------------------
# Enables /admin/prospects — search businesses to pitch. Enable the
# "Places API (New)" in Google Cloud Console, restrict the key to that API.
GOOGLE_PLACES_API_KEY=""

# --- WhatsApp Cloud API automation -------------------------------------------
# Meta WhatsApp Business Cloud API. Enable these to send messages, receive a
# webhook inbox, and run the AI auto-reply bot.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_NUMBER=""   # your business number in E.164, e.g. +917725004639
WHATSAPP_VERIFY_TOKEN=""      # any secret you choose; used for webhook verification
WHATSAPP_AUTO_REPLY="false"   # "true" to let the AI answer inbound messages
# Point Meta's webhook at: https://<your-domain>/api/whatsapp/webhook
